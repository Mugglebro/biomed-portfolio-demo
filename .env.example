# 企业微信邮箱 SMTP 配置示例
# 注意：SMTP_PASSWORD 通常是邮箱授权码，不一定是登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=
MAIL_USE_SSL=true
MAIL_USE_TLS=false

# 邮件反馈自动采集。网易邮箱通常使用 imap.163.com:993。
# 未单独填写 IMAP_USER/IMAP_PASSWORD 时，会复用 SMTP_USER/SMTP_PASSWORD。
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
FEEDBACK_MAIL_TO=
